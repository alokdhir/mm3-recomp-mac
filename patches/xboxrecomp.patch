+    /* Pair, general registers: bits 29:26 = 1010. */
+    if ((insn & 0x3C000000u) == 0x28000000u) {
+        unsigned idx = (insn >> 23) & 3u;
+        int load = (insn >> 22) & 1;
+        unsigned rt2 = (insn >> 10) & 31u;
+        unsigned width = (size == 2u) ? 8u : 4u;
+        int sign = 0;
+        int64_t imm7;
+        uint64_t base, addr;
+        uint32_t off0;
