+/* ===================================================================== */
+/* Threads                                                               */
+/* ===================================================================== */
+
+static void *thread_trampoline(void *arg)
+{
+    w32_object *o = (w32_object *)arg;
+    t_self_obj = o;
+    t_tid      = o->tid;
+
+    /* CREATE_SUSPENDED gate */
+    pthread_mutex_lock(&o->lock);
+    while (o->suspend_count > 0)
+        pthread_cond_wait(&o->gate, &o->lock);
+    o->running = 1;
+    pthread_mutex_unlock(&o->lock);
+
+    DWORD rc = o->start ? o->start(o->start_param) : 0;
+
+    pthread_mutex_lock(&o->lock);
+    o->exit_code = rc;
+    o->exited    = 1;
+    o->signaled  = 1;
+    pthread_cond_broadcast(&o->cond);
+    pthread_mutex_unlock(&o->lock);
+
+    obj_release(o);   /* drop the trampoline's reference */
+    return NULL;
+}
+
+HANDLE CreateThread(LPSECURITY_ATTRIBUTES sa, SIZE_T stackSize,
+                    LPTHREAD_START_ROUTINE start, LPVOID param,
+                    DWORD flags, LPDWORD threadId)
+{
+    (void)sa;
+    w32_object *o = obj_alloc(K_THREAD);
+    o->start         = start;
+    o->start_param   = param;
+    o->tid           = (DWORD)InterlockedIncrement(&s_next_tid);
+    o->suspend_count = (flags & CREATE_SUSPENDED) ? 1 : 0;
+    o->refcount      = 2;   /* one for caller, one for the trampoline */
+
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    /* Win32 commits stackSize inside a reservation of at least 1 MB; a
+     * pthread gets exactly what it asks for (512 KB by default on Darwin).
+     * Titles pass their Xbox kernel stack sizes -- a few KB -- and every
+     * guest call is a host call here, so reserve generously: the pages are
+     * only committed as the stack grows. */
+    {
+        SIZE_T want = stackSize < ((SIZE_T)16 << 20) ? ((SIZE_T)16 << 20) : stackSize;
+        pthread_attr_setstacksize(&attr, want);
+    }
+
+    if (pthread_create(&o->thread, &attr, thread_trampoline, o) != 0) {
+        pthread_attr_destroy(&attr);
+        o->refcount = 1;
+        obj_release(o);
+        SetLastError(8 /* ERROR_NOT_ENOUGH_MEMORY */);
+        return NULL;
+    }
+    pthread_attr_destroy(&attr);
+    o->thread_joinable = 1;
+
+    if (threadId) *threadId = o->tid;
+    return (HANDLE)o;
+}
+
+VOID ExitThread(DWORD exitCode)
+{
+    w32_object *o = t_self_obj;
+    if (o) {
+        pthread_mutex_lock(&o->lock);
+        o->exit_code = exitCode;
+        o->exited    = 1;
+        o->signaled  = 1;
+        pthread_cond_broadcast(&o->cond);
+        pthread_mutex_unlock(&o->lock);
+        obj_release(o);
+    }
+    pthread_exit(NULL);
+}
+
+BOOL GetExitCodeThread(HANDLE h, LPDWORD exitCode)
+{
+    w32_object *o = obj_of(h);
+    if (!o || o->kind != K_THREAD || !exitCode) return FALSE;
+    pthread_mutex_lock(&o->lock);
+    *exitCode = o->exited ? o->exit_code : STILL_ACTIVE;
+    pthread_mutex_unlock(&o->lock);
+    return TRUE;
+}
+
+DWORD ResumeThread(HANDLE h)
+{
+    w32_object *o = obj_of(h);
+    if (!o || o->kind != K_THREAD) return (DWORD)-1;
+    pthread_mutex_lock(&o->lock);
+    DWORD prev = (DWORD)o->suspend_count;
+    if (o->suspend_count > 0 && --o->suspend_count == 0) {
+#if defined(__APPLE__)
+        if (o->running && !o->exited)
+            thread_resume(pthread_mach_thread_np(o->thread));
+        else
+#endif
+        pthread_cond_broadcast(&o->gate);
+    }
+    pthread_mutex_unlock(&o->lock);
+    return prev;
+}
+
+DWORD SuspendThread(HANDLE h)
+{
+    /* Before the thread runs, the count holds it at the CREATE_SUSPENDED
+     * gate. Once it runs, Darwin suspends it for real through its Mach
+     * thread (a thread suspending itself releases the lock first, or its
+     * resumer could never take it); elsewhere mid-run suspension is not
+     * supported and only the count is kept. */
+    w32_object *o = obj_of(h);
+    if (!o || o->kind != K_THREAD) return (DWORD)-1;
+    pthread_mutex_lock(&o->lock);
+    DWORD prev = (DWORD)o->suspend_count;
+    o->suspend_count++;
+#if defined(__APPLE__)
+    if (prev == 0 && o->running && !o->exited) {
+        mach_port_t port = pthread_mach_thread_np(o->thread);
+        if (pthread_equal(o->thread, pthread_self())) {
+            pthread_mutex_unlock(&o->lock);
+            thread_suspend(port);
+            return prev;
+        }
+        thread_suspend(port);
+    }
+#endif
+    pthread_mutex_unlock(&o->lock);
+    return prev;
+}
+
+BOOL TerminateThread(HANDLE h, DWORD exitCode)
+{
+    w32_object *o = obj_of(h);
+    if (!o || o->kind != K_THREAD) return FALSE;
+    pthread_cancel(o->thread);
+    pthread_mutex_lock(&o->lock);
+    o->exit_code = exitCode;
+    o->exited    = 1;
+    o->signaled  = 1;
+    pthread_cond_broadcast(&o->cond);
+    pthread_mutex_unlock(&o->lock);
+    return TRUE;
+}
+
+BOOL SetThreadPriority(HANDLE h, int priority)
+{
+    w32_object *o = (h == PSEUDO_CURRENT_THREAD) ? t_self_obj : obj_of(h);
+    if (o && o->kind == K_THREAD) o->priority = priority;
+    return TRUE;   /* real RT priorities need privileges; tracked only */
+}
+
+int GetThreadPriority(HANDLE h)
+{
+    w32_object *o = (h == PSEUDO_CURRENT_THREAD) ? t_self_obj : obj_of(h);
+    return (o && o->kind == K_THREAD) ? o->priority : THREAD_PRIORITY_NORMAL;
+}
+
+VOID SwitchToThread(void) { sched_yield(); }
+
+DWORD QueueUserAPC(PAPCFUNC func, HANDLE thread, ULONG_PTR data)
+{
+    w32_object *o = (thread == PSEUDO_CURRENT_THREAD) ? t_self_obj : obj_of(thread);
+    if (!o || o->kind != K_THREAD) return 0;
+    pthread_mutex_lock(&o->lock);
+    DWORD ok = 0;
+    if (o->apc_count < W32_MAX_APC) {
+        o->apc_func[o->apc_count] = func;
+        o->apc_data[o->apc_count] = data;
+        o->apc_count++;
+        ok = 1;
+    }
+    pthread_mutex_unlock(&o->lock);
+    return ok;
+}
