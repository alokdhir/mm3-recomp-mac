-uint32_t xbox_ContiguousAlloc(uint32_t size, uint32_t alignment)
-{
-    uint32_t result, start;
-    const uint32_t limit = XBOX_CONTIG_SIZE - XBOX_GPU_INSTANCE_DEFAULT;
