-    for (int m = 0; m < XBOX_NUM_MIRRORS; m++) {
-        DWORD old;
-        if (g_mirror_views[m] &&
-            VirtualProtect(g_mirror_views[m], g_memory_size,
-                           PAGE_READONLY, &old)) {
-            n++;
-        }
-    }
-    fprintf(stderr, "  Mirrors: %d/%d made read-only (debug)\n",
-            n, XBOX_NUM_MIRRORS);
-}
