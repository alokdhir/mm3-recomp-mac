+BOOL GetComputerNameA(char *buf, LPDWORD size)
+{
+    if (!buf || !size || *size == 0)
+        return FALSE;
+    if (gethostname(buf, *size) != 0) {
+        buf[0] = '\0';
+        return FALSE;
