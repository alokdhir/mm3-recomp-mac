-static int nv2a_dma_pending(volatile uint32_t *regs)
-{
-    return *(volatile uint32_t *)((char *)regs + NV2A_PFIFO_DMA_PUT) !=
-           *(volatile uint32_t *)((char *)regs + NV2A_PFIFO_DMA_GET) ||
