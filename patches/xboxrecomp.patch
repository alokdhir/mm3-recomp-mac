-        mcpx_apu_mmio_write(g_apu_state, mmio_offset, imm, access_size);
-        ctx->Rip += prefix_len + 1 + modrm_len + 4;
-        g_apu_mmio_write_count++;
-        return true;
-    }
-
-    /* MOV r/m8, imm8 (write: C6 /0) */
-    if (opcode[0] == 0xC6) {
