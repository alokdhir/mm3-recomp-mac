-#endif
-
-/* Calling conventions: x86-64 SysV has a single convention. GCC accepts and
- * ignores these attributes on 64-bit, but expanding to nothing is cleaner and
- * avoids -Wattributes noise. */
-#define __stdcall
-#define __cdecl
-#define __fastcall
-#define __thiscall
