+    next = 48000 / NUM_SAMPLES_PER_FRAME * 5;
+    for (int list = 0; list < 3; list++) {
+        uint32_t v = d->regs[voice_list_regs[list].top];
+        while (v != 0xFFFF && len[list] < MCPX_HW_MAX_VOICES) {
