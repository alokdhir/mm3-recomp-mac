- * Platform-independent.
- */
-static int match_prefix(const char* path, const char* prefix)
-{
-    int i = 0;
-    while (prefix[i]) {
-        if (tolower((unsigned char)path[i]) != tolower((unsigned char)prefix[i]))
-            return 0;
-        i++;
-    }
-    return i;
-}
