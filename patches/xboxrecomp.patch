+/* ============================================================
+ * Trap-free access (arm64 Darwin's ordered accessors)
+ * ============================================================
+ * The generated code's memory accessors (mm3_recomp_types.h) send an address
+ * in the APU's register window here instead of letting it fault: the same
+ * register model as the trap path, without a signal per access (several
+ * microseconds each -- DirectSound's voice updates touch these registers
+ * thousands of times a second). Fenced like the trap, which orders the access
+ * against everything around it. 0 when the APU is off: the caller then makes
+ * the plain access, which faults as before. */
+/* On unless RECOMP_APU_DIRECT=0, which sends every access down the fault
+ * path. The direct path once cost MM3 its sound effects partway through a
+ * race (voice lists looping, DirectSound starting no more voices): its speed
+ * widened a race between DirectSound's interrupt and the title's own list
+ * edits, which xbox_IrqlSyncInterrupts now closes. The fault path only made
+ * that race rarer. */
+static int apu_direct_off(void)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("RECOMP_APU_DIRECT") && atoi(getenv("RECOMP_APU_DIRECT")) == 0;
+    return off;
+}
+
+int xbox_ApuDirectRead(uint32_t va, unsigned size, uint64_t *out)
+{
+    if (!g_apu_state || apu_direct_off()) return 0;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    *out = mcpx_apu_mmio_read(g_apu_state, va - APU_MMIO_BASE, size);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    g_apu_mmio_read_count++;
+    return 1;
+}
+
+int xbox_ApuDirectWrite(uint32_t va, uint64_t value, unsigned size)
+{
+    if (!g_apu_state || apu_direct_off()) return 0;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    mcpx_apu_mmio_write(g_apu_state, va - APU_MMIO_BASE, value, size);
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    g_apu_mmio_write_count++;
+    return 1;
+}
