+        if (size == 1u && load) sign = 1;            /* LDPSW */
+        else if (size != 0u && size != 2u) return 0;
+        imm7 = (int64_t)mmio_a64_sext((insn >> 15) & 0x7Fu, 7) * (int64_t)width;
+        base = *mmio_a64_xreg(ctx, rn, 1);
+        addr = (idx == 1u) ? base : base + (uint64_t)imm7;
+        /* The fault names whichever half touched the page first. */
+        off0 = (uint32_t)(off - (uint32_t)(ctx->far - addr));
