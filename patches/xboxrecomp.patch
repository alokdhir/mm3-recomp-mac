-/* Mutexes                                                               */
-/* ===================================================================== */
-
-HANDLE CreateMutexA(LPSECURITY_ATTRIBUTES sa, BOOL initialOwner, LPCSTR name)
-{
-    (void)sa; (void)name;
-    w32_object *o = obj_alloc(K_MUTEX);
-    if (initialOwner) { o->mtx_owner = GetCurrentThreadId(); o->mtx_recursion = 1; }
-    return (HANDLE)o;
-}
