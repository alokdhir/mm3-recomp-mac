+            } else {
+                imm9 = (int64_t)mmio_a64_sext((insn >> 12) & 0x1FFu, 9);
+                if (form == 1u || form == 3u) writeback = 1;
+                else if (form == 2u) return 0;   /* LDTR/STTR */
