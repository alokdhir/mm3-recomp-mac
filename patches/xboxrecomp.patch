diff --git a/src/platform/posix_veh.c b/src/platform/posix_veh.c
new file mode 100644
index 0000000..5a4604b
--- /dev/null
+++ b/src/platform/posix_veh.c
@@ -0,0 +1,159 @@
+/*
+ * posix_veh.c -- Win32 vectored exception handling on arm64 Darwin.
+ *
+ * The runtime traps device registers by leaving their pages inaccessible and
+ * servicing the fault (mmio_decode.h). On Windows that is a vectored handler;
+ * here the same handlers are called from SIGSEGV/SIGBUS with a CONTEXT that
+ * points at the signal frame's thread state, so a handler that advances the
+ * PC resumes the thread past the emulated access.
+ *
+ * Darwin delivers a protection fault on a mapped page as SIGBUS and a fault
+ * on an unmapped address as SIGSEGV; both are routed.
+ *
+ * Handlers run on the faulting thread, synchronously, as VEH does. The table
+ * is fixed-size and lock-free: registration happens during start-up, and a
+ * signal handler must not take a lock the interrupted thread may hold.
+ *
+ * Under lldb, EXC_BAD_ACCESS is caught as a Mach exception before it becomes
+ * a signal. To let the handlers run:
+ *   process handle SIGSEGV SIGBUS -n false -p true -s false
+ * and `settings set platform.plugin.darwin.ignored-exceptions EXC_BAD_ACCESS`.
+ */
+#if defined(__APPLE__) && defined(__aarch64__)
+
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ucontext.h>
+#include <mach/arm/thread_status.h>
+
+#include "xbox_winnt.h"
+
+#define VEH_MAX 16
+
+static _Atomic(PVECTORED_EXCEPTION_HANDLER) s_handlers[VEH_MAX];
+static _Atomic(LPTOP_LEVEL_EXCEPTION_FILTER) s_unhandled;
+static atomic_flag s_installed = ATOMIC_FLAG_INIT;
+static struct sigaction s_prev_segv, s_prev_bus;
+
+/* ESR_ELx data abort, from a lower or the current exception level. */
+static int esr_is_data_abort(uint32_t esr)
+{
+    uint32_t ec = esr >> 26;
+    return ec == 0x24u || ec == 0x25u;
+}
+
+static void chain_previous(int sig, siginfo_t *si, void *uc)
+{
+    const struct sigaction *prev = sig == SIGBUS ? &s_prev_bus : &s_prev_segv;
+
+    if ((prev->sa_flags & SA_SIGINFO) && prev->sa_sigaction) {
+        prev->sa_sigaction(sig, si, uc);
+        return;
+    }
+    if (prev->sa_handler != SIG_DFL && prev->sa_handler != SIG_IGN &&
+        prev->sa_handler) {
+        prev->sa_handler(sig);
+        return;
+    }
+    /* Default action: restore it and return. The access faults again and
+     * the process dies with the original signal, faulting PC intact. */
+    signal(sig, SIG_DFL);
+}
+
+static void veh_signal(int sig, siginfo_t *si, void *ucv)
+{
+    ucontext_t *uc = (ucontext_t *)ucv;
+    EXCEPTION_RECORD record;
+    CONTEXT context;
+    EXCEPTION_POINTERS pointers;
+    int i;
+
+    memset(&record, 0, sizeof record);
+    context.ss = &uc->uc_mcontext->__ss;
+    context.ns = &uc->uc_mcontext->__ns;
+    context.far = uc->uc_mcontext->__es.__far;
+    context.esr = uc->uc_mcontext->__es.__esr;
+    context.EFlags = 0;
+
+    record.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+    record.ExceptionAddress = (PVOID)arm_thread_state64_get_pc(uc->uc_mcontext->__ss);
+    record.NumberParameters = 2;
+    record.ExceptionInformation[0] =
+        esr_is_data_abort(context.esr) && (context.esr & (1u << 6)) ? 1 : 0;
+    record.ExceptionInformation[1] = (ULONG_PTR)si->si_addr;
+
+    pointers.ExceptionRecord = &record;
+    pointers.ContextRecord = &context;
+
+    for (i = 0; i < VEH_MAX; i++) {
+        PVECTORED_EXCEPTION_HANDLER h = atomic_load(&s_handlers[i]);
+        if (h && h(&pointers) == EXCEPTION_CONTINUE_EXECUTION)
+            return;
+    }
+    {
+        LPTOP_LEVEL_EXCEPTION_FILTER f = atomic_load(&s_unhandled);
+        if (f)
+            f(&pointers);
+    }
+    chain_previous(sig, si, ucv);
+}
+
+static void veh_install(void)
+{
+    struct sigaction sa;
+
+    if (atomic_flag_test_and_set(&s_installed))
+        return;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = veh_signal;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, &s_prev_segv);
+    sigaction(SIGBUS, &sa, &s_prev_bus);
+}
+
+PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
+{
+    int i;
+
+    if (!Handler)
+        return NULL;
+    veh_install();
+    if (First) {
+        /* Front of the list: shift the others down one. Start-up only. */
+        if (atomic_load(&s_handlers[VEH_MAX - 1]))
+            return NULL;
+        for (i = VEH_MAX - 1; i > 0; i--)
+            atomic_store(&s_handlers[i], atomic_load(&s_handlers[i - 1]));
+        atomic_store(&s_handlers[0], Handler);
+        return (PVOID)Handler;
+    }
