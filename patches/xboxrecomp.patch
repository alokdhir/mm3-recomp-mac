+/*
+ * recomp_thread_state.h -- a guest thread's x86 state, in one thread-local
+ * object.
+ *
+ * The recompiled code keeps the registers that cross function boundaries
+ * (eax..edi, ebp, esp), the x87 stack and its status, the direction flag and
+ * the FS base per host thread. As separate thread-local variables each one
+ * is found through its own descriptor call on macOS (_tlv_get_addr) wherever
+ * a function touches it -- some 70,000 call sites, a tenth of the game
+ * thread. As fields of one object, a function finds them all with one.
+ * The g_* names stay, as macros for the fields, so every user reads the
+ * same; declare nothing of these names elsewhere, include this instead.
+ */
+#ifndef RECOMP_THREAD_STATE_H
+#define RECOMP_THREAD_STATE_H
+
+#include <stdint.h>
+
+#if defined(_MSC_VER)
+#  define RECOMP_THREAD_STATE_TLS __declspec(thread)
+#else
+#  define RECOMP_THREAD_STATE_TLS __thread
+#endif
+
+/* Fields are ts_-prefixed: the generated code defines eax, esp ... as macros. */
+typedef struct RecompThreadState {
+    uint32_t ts_eax, ts_ecx, ts_edx, ts_esp;
+    uint32_t ts_ebx, ts_esi, ts_edi, ts_ebp;
+    uint32_t ts_fs_base;         /* the thread's TIB (fs:0) */
+    uint32_t ts_seh_ebp;         /* frame of the innermost SEH handler */
+    int ts_df;                   /* direction flag */
+    int ts_fp_top, ts_fp_cmp;
+    uint16_t ts_fp_control_word, ts_fp_cc;
+    double ts_fp_stack[8];
+} RecompThreadState;
+
+extern RECOMP_THREAD_STATE_TLS RecompThreadState g_thread_state;
+
+#define g_eax             (g_thread_state.ts_eax)
+#define g_ecx             (g_thread_state.ts_ecx)
+#define g_edx             (g_thread_state.ts_edx)
+#define g_esp             (g_thread_state.ts_esp)
+#define g_ebx             (g_thread_state.ts_ebx)
+#define g_esi             (g_thread_state.ts_esi)
+#define g_edi             (g_thread_state.ts_edi)
+#define g_ebp             (g_thread_state.ts_ebp)
+#define g_fs_base         (g_thread_state.ts_fs_base)
+#define g_seh_ebp         (g_thread_state.ts_seh_ebp)
+#define g_df              (g_thread_state.ts_df)
+#define g_fp_top          (g_thread_state.ts_fp_top)
+#define g_fp_cmp          (g_thread_state.ts_fp_cmp)
+#define g_fp_control_word (g_thread_state.ts_fp_control_word)
+#define g_fp_cc           (g_thread_state.ts_fp_cc)
+#define g_fp_stack        (g_thread_state.ts_fp_stack)
+
+#endif /* RECOMP_THREAD_STATE_H */
