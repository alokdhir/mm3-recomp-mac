-/* ===================================================================== */
-
-HANDLE CreateSemaphoreA(LPSECURITY_ATTRIBUTES sa, LONG initial, LONG maximum, LPCSTR name)
-{
-    (void)sa; (void)name;
-    w32_object *o = obj_alloc(K_SEM);
