+static __thread w32_object *t_self_obj = NULL;
+static __thread DWORD       t_tid      = 0;
+static volatile LONG        s_next_tid = 1000;
+
+DWORD GetCurrentThreadId(void)
+{
+    if (t_tid == 0)
+        t_tid = (DWORD)InterlockedIncrement(&s_next_tid);
+    return t_tid;
