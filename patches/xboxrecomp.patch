+# Shared FMV player: Media Foundation decode onto a D3D8 texture.
+# XBOX_VIDEO_BACKEND_SOURCES, set by an including project, replace the D3D11
+# renderer (nv2a_d3d11.c) with a host renderer implementing nv2a_d3d11.h, and
+# XBOX_VIDEO_BACKEND_INCLUDES / _LIBRARIES go with them (the macOS port's
+# Metal renderer and window).
+if(XBOX_VIDEO_BACKEND_SOURCES)
+    set(xbox_video_backend ${XBOX_VIDEO_BACKEND_SOURCES})
+else()
+    set(xbox_video_backend nv2a_d3d11.c)
+endif()
+add_library(xbox_video STATIC
+    video_player.c
+    video_pump.c
+    fb_present.c
+    ${xbox_video_backend}
+    spike_sampler.c
+)
+target_include_directories(xbox_video PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_SOURCE_DIR}/..
+)
+target_link_libraries(xbox_video PUBLIC xbox_d3d8)
+if(XBOX_VIDEO_BACKEND_SOURCES)
+    target_include_directories(xbox_video PRIVATE ${XBOX_VIDEO_BACKEND_INCLUDES})
+    target_link_libraries(xbox_video PUBLIC ${XBOX_VIDEO_BACKEND_LIBRARIES})
+endif()
+if(WIN32)
+    target_link_libraries(xbox_video PUBLIC mfplat mfreadwrite mfuuid mf ole32 dbghelp winmm)
+endif()
