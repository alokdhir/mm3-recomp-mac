+                } else {
+                    val = rd(dev, off, (int)width);
+                    if (width < 8u) val &= ((__uint128_t)1 << (width * 8u)) - 1u;
+                }
+                *v = val;                         /* scalar loads zero the rest */
+            } else if (width == 16u) {
+                wr(dev, off, (uint64_t)*v, 8);
+                wr(dev, off + 8u, (uint64_t)(*v >> 64), 8);
+            } else {
+                wr(dev, off, (uint64_t)*v, (int)width);
+            }
+        } else {
+            unsigned width = 1u << size;
+            switch (opc) {
+            case 0:                                          /* STR*  */
+                wr(dev, off, mmio_a64_get(ctx, rt), (int)width);
+                break;
+            case 1: {                                        /* LDR*  */
+                uint64_t val = rd(dev, off, (int)width);
+                if (width < 8u) val &= (1ULL << (width * 8u)) - 1u;
+                mmio_a64_set(ctx, rt, val);
+                break;
+            }
+            case 2:                                          /* LDRS* to X / PRFM */
+                if (size == 3u) break;
+                mmio_a64_set(ctx, rt, mmio_a64_sext(rd(dev, off, (int)width),
+                                                    (int)width * 8));
+                break;
+            default:                                         /* LDRS* to W */
+                if (size >= 2u) return 0;
+                mmio_a64_set(ctx, rt, (uint32_t)mmio_a64_sext(
+                    rd(dev, off, (int)width), (int)width * 8));
+                break;
+            }
+        }
+        if (writeback)
+            *mmio_a64_xreg(ctx, rn, 1) += (uint64_t)imm9;
+        mmio_a64_advance(ctx);
+        return 1;
+    }
