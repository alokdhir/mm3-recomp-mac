+            unsigned width = (opc & 2u) ? 16u : (1u << size);
+            int load = opc & 1u;
+            __uint128_t *v = &ctx->ns->__v[rt];
+            if ((opc & 2u) && size != 0u) return 0;
+            if (load) {
+                __uint128_t val = 0;
+                if (width == 16u) {
+                    val = (__uint128_t)rd(dev, off, 8)
