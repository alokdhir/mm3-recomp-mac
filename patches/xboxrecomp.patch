+DWORD GetCurrentProcessId(void) { return (DWORD)getpid(); }
+HANDLE GetCurrentThread(void)   { return t_self_obj ? (HANDLE)t_self_obj : PSEUDO_CURRENT_THREAD; }
+HANDLE GetCurrentProcess(void)  { return PSEUDO_CURRENT_PROCESS; }
+
+/* What makes a HANDLE one of ours. Win32 answers ERROR_INVALID_HANDLE for a
+ * value that names no object; here a HANDLE is a pointer, and the kernel HLE
+ * does pass values that are not -- a guest dispatcher object's address when
+ * no shadow event exists, or a raw guest VA. Dereferencing one either locks
+ * a "mutex" made of guest data or faults outright, so each entry point
+ * resolves through obj_of, which looks the value up in a registry of live
+ * objects (as the Win32 handle table would) without touching it. */
+static pthread_mutex_t s_reg_lock = PTHREAD_MUTEX_INITIALIZER;
+static uintptr_t *s_reg;                  /* open addressing; 0 empty, 1 removed */
+static size_t s_reg_cap, s_reg_used, s_reg_live;
+
+static size_t reg_slot(uintptr_t p, size_t cap)
+{
+    return (size_t)(((uint64_t)(p >> 4) * 0x9E3779B97F4A7C15ull) >> 20) & (cap - 1);
+}
+
+static void reg_grow(void)
+{
+    size_t cap = s_reg_cap ? s_reg_cap * 2 : 1024, i;
+    uintptr_t *t = (uintptr_t *)calloc(cap, sizeof *t);
+    if (!t) abort();
+    for (i = 0; i < s_reg_cap; i++)
+        if (s_reg[i] > 1) {
+            size_t j = reg_slot(s_reg[i], cap);
+            while (t[j]) j = (j + 1) & (cap - 1);
+            t[j] = s_reg[i];
+        }
+    free(s_reg);
+    s_reg = t;
+    s_reg_cap = cap;
+    s_reg_used = s_reg_live;
+}
+
+static void reg_add(const void *o)
+{
+    size_t j;
+    pthread_mutex_lock(&s_reg_lock);
+    if ((s_reg_used + 1) * 2 > s_reg_cap) reg_grow();
+    j = reg_slot((uintptr_t)o, s_reg_cap);
+    while (s_reg[j] > 1) j = (j + 1) & (s_reg_cap - 1);
+    if (!s_reg[j]) s_reg_used++;
+    s_reg[j] = (uintptr_t)o;
+    s_reg_live++;
+    pthread_mutex_unlock(&s_reg_lock);
+}
+
+static size_t reg_find_locked(uintptr_t p)
+{
+    size_t j;
+    if (!s_reg_cap) return (size_t)-1;
+    for (j = reg_slot(p, s_reg_cap); s_reg[j]; j = (j + 1) & (s_reg_cap - 1))
+        if (s_reg[j] == p) return j;
+    return (size_t)-1;
+}
+
+static void reg_remove(const void *o)
+{
+    size_t j;
+    pthread_mutex_lock(&s_reg_lock);
+    j = reg_find_locked((uintptr_t)o);
+    if (j != (size_t)-1) { s_reg[j] = 1; s_reg_live--; }
+    pthread_mutex_unlock(&s_reg_lock);
+}
+
+static w32_object *obj_of(HANDLE h)
+{
+    size_t j;
+    if (!h || h == INVALID_HANDLE_VALUE || (uintptr_t)h < 0x10000u || ((uintptr_t)h & 7u))
+        return NULL;
+    pthread_mutex_lock(&s_reg_lock);
+    j = reg_find_locked((uintptr_t)h);
+    pthread_mutex_unlock(&s_reg_lock);
+    return j == (size_t)-1 ? NULL : (w32_object *)h;
+}
+
+static w32_object *obj_alloc(w32_kind kind)
+{
+    w32_object *o = (w32_object *)calloc(1, sizeof(w32_object));
+    o->kind     = kind;
+    o->refcount = 1;
+    pthread_mutex_init(&o->lock, NULL);
+    pthread_cond_init(&o->cond, NULL);
+    pthread_cond_init(&o->gate, NULL);
+    reg_add(o);
+    return o;
+}
+
+static void obj_release(w32_object *o)
+{
+    if (InterlockedDecrement(&o->refcount) > 0)
+        return;
+    reg_remove(o);
+    if (o->kind == K_FILE) {
+        if (o->fd >= 0) close(o->fd);
+        free(o->file_path);
+    } else if (o->kind == K_FILEMAP) {
+        if (o->fd >= 0) close(o->fd);
+    } else if (o->kind == K_WAITABLE_TIMER) {
+        /* Waitable timers: no special cleanup needed */
+    }
+    pthread_mutex_destroy(&o->lock);
+    pthread_cond_destroy(&o->cond);
+    pthread_cond_destroy(&o->gate);
+    free(o);
+}
+
+/* ---- fd-backed file handle (for the file-I/O HLE) -------------------- */
+HANDLE w32_open_handle(int fd, const char *host_path)
+{
+    w32_object *o = obj_alloc(K_FILE);
+    o->fd        = fd;
+    o->file_path = host_path ? strdup(host_path) : NULL;
+    return (HANDLE)o;
+}
+
+int w32_handle_fd(HANDLE h)
+{
+    w32_object *o = obj_of(h);
+    return (o && o->kind == K_FILE) ? o->fd : -1;
+}
+
+const char *w32_handle_path(HANDLE h)
+{
+    w32_object *o = obj_of(h);
+    return (o && o->kind == K_FILE) ? o->file_path : NULL;
+}
+
+BOOL CloseHandle(HANDLE h)
+{
+    if (!h || h == PSEUDO_CURRENT_THREAD || h == PSEUDO_CURRENT_PROCESS ||
+        h == INVALID_HANDLE_VALUE)
+        return TRUE;
+    if (!obj_of(h)) {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    obj_release(obj_of(h));
+    return TRUE;
+}
+
+BOOL DuplicateHandle(HANDLE srcProc, HANDLE src, HANDLE dstProc, PHANDLE dst,
+                     DWORD access, BOOL inherit, DWORD options)
+{
+    (void)srcProc; (void)dstProc; (void)access; (void)inherit;
+    if (!dst) return FALSE;
+    if (src == PSEUDO_CURRENT_THREAD)  src = GetCurrentThread();
+    if (src == PSEUDO_CURRENT_PROCESS) { *dst = src; return TRUE; }
+    if (src == PSEUDO_CURRENT_THREAD || !src) { *dst = src; return TRUE; }
+    w32_object *o = obj_of(src);
+    if (!o) { SetLastError(ERROR_INVALID_HANDLE); return FALSE; }
+    InterlockedIncrement(&o->refcount);
+    *dst = src;
+    if (options & DUPLICATE_CLOSE_SOURCE)
+        obj_release(o);
+    return TRUE;
+}
+
+/* ---- deadline helper -------------------------------------------------- */
+static void deadline_from_ms(DWORD ms, struct timespec *ts)
+{
+    clock_gettime(CLOCK_REALTIME, ts);
+    ts->tv_sec  += ms / 1000;
+    ts->tv_nsec += (long)(ms % 1000) * 1000000L;
+    if (ts->tv_nsec >= 1000000000L) { ts->tv_sec++; ts->tv_nsec -= 1000000000L; }
+}
+
+/* Run any pending user-APCs for the calling thread. Returns count run. */
+static int drain_apcs(void)
+{
+    w32_object *o = t_self_obj;
+    int run = 0;
+    if (!o) return 0;
+    pthread_mutex_lock(&o->lock);
+    while (o->apc_count > 0) {
+        PAPCFUNC  f = o->apc_func[0];
+        ULONG_PTR d = o->apc_data[0];
+        memmove(o->apc_func, o->apc_func + 1, sizeof(PAPCFUNC) * (o->apc_count - 1));
+        memmove(o->apc_data, o->apc_data + 1, sizeof(ULONG_PTR) * (o->apc_count - 1));
+        o->apc_count--;
+        pthread_mutex_unlock(&o->lock);
+        f(d);
+        run++;
+        pthread_mutex_lock(&o->lock);
+    }
+    pthread_mutex_unlock(&o->lock);
+    return run;
+}
