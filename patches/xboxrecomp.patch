-        if (result & (1ULL << (access_size * 8 - 1))) ctx->EFlags |= 0x0080;
-        ctx->Rip += prefix_len + 1 + modrm_len;
-        g_apu_mmio_read_count++;
-        return true;
-    }
-
-    /* OR r/m, r (08/09) */
