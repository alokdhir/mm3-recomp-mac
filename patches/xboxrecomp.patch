-    static DWORD last_ms;
-    static uint32_t last_sum;
-    DWORD now;
-    uint32_t sum = 0, nonzero = 0, i, n;
-    const uint32_t *p;
-
-    if (!s_nv2a_trace || !s_fb_va || !s_fb_pitch)
-        return;
-    now = GetTickCount();
