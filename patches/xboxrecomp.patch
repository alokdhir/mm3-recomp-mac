-                                 PVOID context, PVOID env)
-{
-    (void)env;
-    /* Run on a throwaway detached thread. */
-    struct w32_tp_args *a = (struct w32_tp_args *)malloc(sizeof(*a));
-    a->cb = callback; a->ctx = context;
-    pthread_t th;
