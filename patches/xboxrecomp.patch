+#elif defined(__APPLE__) && defined(__aarch64__)
+/*
+ * arm64: the access is one A64 load or store, and the instruction set makes
+ * that simpler than x86 -- a read-modify-write or a compare against memory is
+ * a separate load and store, each faulting on its own, so only the load/store
+ * classes are decoded. Covered: LDR/STR of every width and signedness in the
+ * unsigned-offset, unscaled, pre/post-index and register-offset forms, the
+ * same for scalar FP/SIMD registers, LDP/STP/LDPSW, and the ordered forms
+ * the generated code's accessors compile to (LDAR/LDAPR/STLR and the
+ * unscaled LDAPUR/LDAPURS/STLUR). Exclusive and atomic read-modify-write
+ * forms are refused (return 0), as is anything else.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <mach/arm/thread_status.h>
+#include "xbox_winnt.h"
+
+/* Rt/Rn 0..30; 31 is XZR as a data register and SP as a base. */
+static inline uint64_t *mmio_a64_xreg(PCONTEXT c, unsigned r, int is_base)
+{
+    if (r < 29) return &c->ss->__x[r];
+    if (r == 29) return &c->ss->__fp;
+    if (r == 30) return &c->ss->__lr;
+    return is_base ? &c->ss->__sp : NULL;
+}
+
+static inline uint64_t mmio_a64_sext(uint64_t v, int bits)
+{
+    uint64_t m = 1ULL << (bits - 1);
+    v &= (bits == 64) ? ~0ULL : ((1ULL << bits) - 1);
+    return (v ^ m) - m;
+}
+
+static inline void mmio_a64_set(PCONTEXT c, unsigned rt, uint64_t v)
+{
+    uint64_t *r = mmio_a64_xreg(c, rt, 0);
+    if (r) *r = v;
+}
+
+static inline uint64_t mmio_a64_get(PCONTEXT c, unsigned rt)
+{
+    uint64_t *r = mmio_a64_xreg(c, rt, 0);
+    return r ? *r : 0;   /* XZR */
+}
+
+static inline void mmio_a64_advance(PCONTEXT c)
+{
+    c->ss->__pc += 4;
+}
+
+static inline int mmio_emulate(PCONTEXT ctx, uint32_t off, void *dev,
+                               mmio_read_fn rd, mmio_write_fn wr)
+{
+    uint32_t insn;
+    unsigned rt, rn, size, opc;
+
+    if (!rd || !wr || !ctx || !ctx->ss)
+        return 0;
+    insn = *(const uint32_t *)(uintptr_t)ctx->ss->__pc;
+    rt = insn & 31u;
+    rn = (insn >> 5) & 31u;
+    size = insn >> 30;
+    opc = (insn >> 22) & 3u;
+
+    /* Load-acquire / store-release, register base only: STLR, LDAR, and
+     * LDAPR (RCpc; the encoding sits inside the class below, so first). */
+    if ((insn & 0x3FFFFC00u) == 0x089FFC00u || (insn & 0x3FFFFC00u) == 0x08DFFC00u ||
+        (insn & 0x3FFFFC00u) == 0x38BFC000u) {
+        unsigned width = 1u << size;
+        if ((insn & 0x3FFFFC00u) == 0x089FFC00u) {
+            wr(dev, off, mmio_a64_get(ctx, rt), (int)width);
+        } else {
+            uint64_t val = rd(dev, off, (int)width);
+            if (width < 8u) val &= (1ULL << (width * 8u)) - 1u;
+            mmio_a64_set(ctx, rt, val);
+        }
+        mmio_a64_advance(ctx);
+        return 1;
+    }
+    /* The same with an unscaled offset (FEAT_LRCPC2): STLUR, LDAPUR, and the
+     * sign-extending LDAPURS to X (opc 2) or W (opc 3). The fault already
+     * gives the address, so the offset needs no decoding. */
+    if ((insn & 0x3F200C00u) == 0x19000000u) {
+        unsigned width = 1u << size;
+        switch (opc) {
+        case 0:
+            wr(dev, off, mmio_a64_get(ctx, rt), (int)width);
+            break;
+        case 1: {
+            uint64_t val = rd(dev, off, (int)width);
+            if (width < 8u) val &= (1ULL << (width * 8u)) - 1u;
+            mmio_a64_set(ctx, rt, val);
+            break;
+        }
+        case 2:
+            if (size == 3u) return 0;
+            mmio_a64_set(ctx, rt, mmio_a64_sext(rd(dev, off, (int)width), (int)width * 8));
+            break;
+        default:
+            if (size >= 2u) return 0;
+            mmio_a64_set(ctx, rt, (uint32_t)mmio_a64_sext(rd(dev, off, (int)width), (int)width * 8));
+            break;
+        }
+        mmio_a64_advance(ctx);
+        return 1;
+    }
+
+    /* Single register, unsigned immediate (bits 29:24 = 111x01) or the
+     * imm9/register forms (111x00, bit 21 and bits 11:10 select). */
+    if ((insn & 0x3B000000u) == 0x39000000u ||
+        (insn & 0x3B000000u) == 0x38000000u) {
+        int simd = (insn >> 26) & 1;
+        int writeback = 0;
+        int64_t imm9 = 0;
+
+        if ((insn & 0x3B000000u) == 0x38000000u) {
+            uint32_t form = (insn >> 10) & 3u;
+            if (insn & (1u << 21)) {
+                if (form != 2u) return 0;        /* register offset only */
+            } else {
+                imm9 = (int64_t)mmio_a64_sext((insn >> 12) & 0x1FFu, 9);
+                if (form == 1u || form == 3u) writeback = 1;
+                else if (form == 2u) return 0;   /* LDTR/STTR */
+            }
+        }
+
+        if (simd) {
+            /* B/H/S/D: size picks the width; opc bit 1 with size 0 is Q. */
+            unsigned width = (opc & 2u) ? 16u : (1u << size);
+            int load = opc & 1u;
+            __uint128_t *v = &ctx->ns->__v[rt];
+            if ((opc & 2u) && size != 0u) return 0;
+            if (load) {
+                __uint128_t val = 0;
+                if (width == 16u) {
+                    val = (__uint128_t)rd(dev, off, 8)
+                        | ((__uint128_t)rd(dev, off + 8u, 8) << 64);
+                } else {
+                    val = rd(dev, off, (int)width);
+                    if (width < 8u) val &= ((__uint128_t)1 << (width * 8u)) - 1u;
+                }
+                *v = val;                         /* scalar loads zero the rest */
+            } else if (width == 16u) {
+                wr(dev, off, (uint64_t)*v, 8);
+                wr(dev, off + 8u, (uint64_t)(*v >> 64), 8);
+            } else {
+                wr(dev, off, (uint64_t)*v, (int)width);
+            }
+        } else {
+            unsigned width = 1u << size;
+            switch (opc) {
+            case 0:                                          /* STR*  */
+                wr(dev, off, mmio_a64_get(ctx, rt), (int)width);
+                break;
+            case 1: {                                        /* LDR*  */
+                uint64_t val = rd(dev, off, (int)width);
+                if (width < 8u) val &= (1ULL << (width * 8u)) - 1u;
+                mmio_a64_set(ctx, rt, val);
+                break;
+            }
+            case 2:                                          /* LDRS* to X / PRFM */
+                if (size == 3u) break;
+                mmio_a64_set(ctx, rt, mmio_a64_sext(rd(dev, off, (int)width),
+                                                    (int)width * 8));
+                break;
+            default:                                         /* LDRS* to W */
+                if (size >= 2u) return 0;
+                mmio_a64_set(ctx, rt, (uint32_t)mmio_a64_sext(
+                    rd(dev, off, (int)width), (int)width * 8));
+                break;
+            }
+        }
+        if (writeback)
+            *mmio_a64_xreg(ctx, rn, 1) += (uint64_t)imm9;
+        mmio_a64_advance(ctx);
+        return 1;
+    }
+
+    /* Pair, general registers: bits 29:26 = 1010. */
+    if ((insn & 0x3C000000u) == 0x28000000u) {
+        unsigned idx = (insn >> 23) & 3u;
+        int load = (insn >> 22) & 1;
+        unsigned rt2 = (insn >> 10) & 31u;
+        unsigned width = (size == 2u) ? 8u : 4u;
+        int sign = 0;
+        int64_t imm7;
+        uint64_t base, addr;
+        uint32_t off0;
+
+        if (size == 1u && load) sign = 1;            /* LDPSW */
+        else if (size != 0u && size != 2u) return 0;
+        imm7 = (int64_t)mmio_a64_sext((insn >> 15) & 0x7Fu, 7) * (int64_t)width;
+        base = *mmio_a64_xreg(ctx, rn, 1);
+        addr = (idx == 1u) ? base : base + (uint64_t)imm7;
+        /* The fault names whichever half touched the page first. */
+        off0 = (uint32_t)(off - (uint32_t)(ctx->far - addr));
+        if (load) {
+            uint64_t a = rd(dev, off0, (int)width);
+            uint64_t b = rd(dev, off0 + width, (int)width);
+            if (sign) {
+                a = mmio_a64_sext(a, 32);
+                b = mmio_a64_sext(b, 32);
+            } else if (width == 4u) {
+                a &= 0xFFFFFFFFu;
+                b &= 0xFFFFFFFFu;
+            }
+            mmio_a64_set(ctx, rt, a);
+            mmio_a64_set(ctx, rt2, b);
+        } else {
+            wr(dev, off0, mmio_a64_get(ctx, rt), (int)width);
+            wr(dev, off0 + width, mmio_a64_get(ctx, rt2), (int)width);
+        }
+        if (idx == 1u || idx == 3u)
+            *mmio_a64_xreg(ctx, rn, 1) = base + (uint64_t)imm7;
+        mmio_a64_advance(ctx);
+        return 1;
+    }
+    return 0;
+}
+
+/* The faulting instruction word, for decode-failure reports. */
+static inline uint32_t mmio_fault_insn(PCONTEXT ctx)
+{
+    return *(const uint32_t *)(uintptr_t)ctx->ss->__pc;
+}
+
+#endif /* _WIN32 / arm64 Darwin */
 #endif /* MMIO_DECODE_H */
diff --git a/src/platform/posix_veh.c b/src/platform/posix_veh.c
new file mode 100644
index 0000000..5a4604b
--- /dev/null
+++ b/src/platform/posix_veh.c
@@ -0,0 +1,159 @@
+/*
+ * posix_veh.c -- Win32 vectored exception handling on arm64 Darwin.
+ *
+ * The runtime traps device registers by leaving their pages inaccessible and
+ * servicing the fault (mmio_decode.h). On Windows that is a vectored handler;
+ * here the same handlers are called from SIGSEGV/SIGBUS with a CONTEXT that
+ * points at the signal frame's thread state, so a handler that advances the
+ * PC resumes the thread past the emulated access.
+ *
+ * Darwin delivers a protection fault on a mapped page as SIGBUS and a fault
+ * on an unmapped address as SIGSEGV; both are routed.
+ *
+ * Handlers run on the faulting thread, synchronously, as VEH does. The table
+ * is fixed-size and lock-free: registration happens during start-up, and a
+ * signal handler must not take a lock the interrupted thread may hold.
+ *
+ * Under lldb, EXC_BAD_ACCESS is caught as a Mach exception before it becomes
+ * a signal. To let the handlers run:
+ *   process handle SIGSEGV SIGBUS -n false -p true -s false
+ * and `settings set platform.plugin.darwin.ignored-exceptions EXC_BAD_ACCESS`.
+ */
+#if defined(__APPLE__) && defined(__aarch64__)
+
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ucontext.h>
+#include <mach/arm/thread_status.h>
+
+#include "xbox_winnt.h"
+
+#define VEH_MAX 16
+
+static _Atomic(PVECTORED_EXCEPTION_HANDLER) s_handlers[VEH_MAX];
+static _Atomic(LPTOP_LEVEL_EXCEPTION_FILTER) s_unhandled;
+static atomic_flag s_installed = ATOMIC_FLAG_INIT;
+static struct sigaction s_prev_segv, s_prev_bus;
+
+/* ESR_ELx data abort, from a lower or the current exception level. */
+static int esr_is_data_abort(uint32_t esr)
+{
+    uint32_t ec = esr >> 26;
+    return ec == 0x24u || ec == 0x25u;
+}
+
+static void chain_previous(int sig, siginfo_t *si, void *uc)
+{
+    const struct sigaction *prev = sig == SIGBUS ? &s_prev_bus : &s_prev_segv;
+
+    if ((prev->sa_flags & SA_SIGINFO) && prev->sa_sigaction) {
+        prev->sa_sigaction(sig, si, uc);
+        return;
+    }
+    if (prev->sa_handler != SIG_DFL && prev->sa_handler != SIG_IGN &&
+        prev->sa_handler) {
+        prev->sa_handler(sig);
+        return;
+    }
+    /* Default action: restore it and return. The access faults again and
+     * the process dies with the original signal, faulting PC intact. */
+    signal(sig, SIG_DFL);
+}
+
+static void veh_signal(int sig, siginfo_t *si, void *ucv)
+{
+    ucontext_t *uc = (ucontext_t *)ucv;
+    EXCEPTION_RECORD record;
+    CONTEXT context;
+    EXCEPTION_POINTERS pointers;
+    int i;
+
+    memset(&record, 0, sizeof record);
+    context.ss = &uc->uc_mcontext->__ss;
+    context.ns = &uc->uc_mcontext->__ns;
+    context.far = uc->uc_mcontext->__es.__far;
+    context.esr = uc->uc_mcontext->__es.__esr;
+    context.EFlags = 0;
+
+    record.ExceptionCode = EXCEPTION_ACCESS_VIOLATION;
+    record.ExceptionAddress = (PVOID)arm_thread_state64_get_pc(uc->uc_mcontext->__ss);
+    record.NumberParameters = 2;
+    record.ExceptionInformation[0] =
+        esr_is_data_abort(context.esr) && (context.esr & (1u << 6)) ? 1 : 0;
+    record.ExceptionInformation[1] = (ULONG_PTR)si->si_addr;
+
+    pointers.ExceptionRecord = &record;
+    pointers.ContextRecord = &context;
+
+    for (i = 0; i < VEH_MAX; i++) {
+        PVECTORED_EXCEPTION_HANDLER h = atomic_load(&s_handlers[i]);
+        if (h && h(&pointers) == EXCEPTION_CONTINUE_EXECUTION)
+            return;
+    }
+    {
+        LPTOP_LEVEL_EXCEPTION_FILTER f = atomic_load(&s_unhandled);
+        if (f)
+            f(&pointers);
+    }
+    chain_previous(sig, si, ucv);
+}
+
+static void veh_install(void)
+{
+    struct sigaction sa;
+
+    if (atomic_flag_test_and_set(&s_installed))
+        return;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = veh_signal;
+    sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, &s_prev_segv);
+    sigaction(SIGBUS, &sa, &s_prev_bus);
+}
+
+PVOID AddVectoredExceptionHandler(ULONG First, PVECTORED_EXCEPTION_HANDLER Handler)
+{
+    int i;
+
+    if (!Handler)
+        return NULL;
+    veh_install();
+    if (First) {
+        /* Front of the list: shift the others down one. Start-up only. */
+        if (atomic_load(&s_handlers[VEH_MAX - 1]))
+            return NULL;
+        for (i = VEH_MAX - 1; i > 0; i--)
+            atomic_store(&s_handlers[i], atomic_load(&s_handlers[i - 1]));
+        atomic_store(&s_handlers[0], Handler);
+        return (PVOID)Handler;
+    }
+    for (i = 0; i < VEH_MAX; i++) {
+        PVECTORED_EXCEPTION_HANDLER expected = NULL;
+        if (atomic_compare_exchange_strong(&s_handlers[i], &expected, Handler))
+            return (PVOID)Handler;
+    }
+    return NULL;
+}
+
+ULONG RemoveVectoredExceptionHandler(PVOID h)
+{
+    int i;
+
+    for (i = 0; i < VEH_MAX; i++) {
+        PVECTORED_EXCEPTION_HANDLER expected = (PVECTORED_EXCEPTION_HANDLER)h;
+        if (h && atomic_compare_exchange_strong(&s_handlers[i], &expected, NULL))
+            return 1;
+    }
+    return 0;
+}
+
+LPTOP_LEVEL_EXCEPTION_FILTER SetUnhandledExceptionFilter(LPTOP_LEVEL_EXCEPTION_FILTER f)
+{
+    veh_install();
+    return atomic_exchange(&s_unhandled, f);
+}
+
+#endif /* __APPLE__ && __aarch64__ */
