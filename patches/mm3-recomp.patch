             sys.exit('pinned lifter changed: fld tbyte patch does not apply')
-        lifter.write_text(text.replace(old, new))
+        text = text.replace(old, new)
+        # xchg with memory is implicitly locked on x86; lift the 32-bit form
+        # to an atomic swap (recomp_xchg32) so it stays one on weakly ordered
+        # hosts. Register-register and narrow forms are unchanged.
+        old_xchg = """        a = _fmt_operand_read(ops[0])
+        b = _fmt_operand_read(ops[1])
+        return [
+            f"{{ uint32_t _tmp = {a};",
+            _fmt_operand_write(ops[0], b),
+            _fmt_operand_write(ops[1], "_tmp") + " }",
+        ]"""
+        new_xchg = """        mem = [o for o in ops[:2] if o.type == "mem"]
+        if len(mem) == 1 and getattr(mem[0], "mem_size", 4) == 4:
+            other = ops[1] if ops[0] is mem[0] else ops[0]
+            if other.type == "reg" and other.reg not in _REG_WIDTH:
+                return [
+                    f"{{ uint32_t _tmp = recomp_xchg32({_fmt_mem(mem[0])}, {_fmt_operand_read(other)});",
+                    _fmt_operand_write(other, "_tmp") + " }",
+                ]
+""" + old_xchg
+        if text.count(old_xchg) != 1:
+            sys.exit('pinned lifter changed: xchg patch does not apply')
+        text = text.replace(old_xchg, new_xchg)
+        # SSE float-to-int conversions: x86's results (integer indefinite out
+        # of range or for NaN; nearest-even for the non-truncating forms)
+        # through recomp_sse_cvt_i32, not a C cast.
+        for width in ('ss', 'sd'):
+            head = ('        if m in ("cvt%s2si", "cvtt%s2si"):\n'
+                    '            if nops >= 2:\n' % (width, width))
+            old_cvt = head + ('                return [_fmt_operand_write(ops[0], '
+                              'f"(int32_t){_sse_read(ops[1])}") + f" /* {m} */"]')
+            new_cvt = head + ('                trunc = 1 if m.startswith("cvtt") else 0\n'
+                              '                return [_fmt_operand_write(ops[0], '
+                              'f"recomp_sse_cvt_i32((double){_sse_read(ops[1])}, {trunc})") '
+                              '+ f" /* {m} */"]')
+            if text.count(old_cvt) != 1:
+                sys.exit('pinned lifter changed: cvt%s2si patch does not apply' % width)
+            text = text.replace(old_cvt, new_cvt)
+        lifter.write_text(text)
     return out
 
 
