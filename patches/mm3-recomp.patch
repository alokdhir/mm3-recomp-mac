diff --git a/src/mods/offline.c b/src/mods/offline.c
new file mode 100644
index 0000000..919ea7c
--- /dev/null
+++ b/src/mods/offline.c
@@ -0,0 +1,47 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "recomp_types.h"
+
+/* Offline play. Upstream dropped its readiness bypass once the original
+ * path reached driving on its own; here that path still holds the boot
+ * screen about 20 s before giving up, so the Mac build keeps the bypass. */
+
+/* MM3's network object's readiness method masks bit 0x20 from
+ * XNetGetTitleXnAddr and returns whether any other bit is set; the
+ * initialization method at 0x195341 polls it every 100 ms. With networking
+ * off (RECOMP_NET unset or 0) report it ready at once. */
+extern void sub_0019531D_original(void);
+void sub_0019531D(void)
+{
+    static int reported;
+    static int bypass = -1;
+    if (bypass < 0) {
+        const char *mode = getenv("RECOMP_NET");
+        bypass = !mode || !*mode || !strcmp(mode, "0");
+    }
+    if (!bypass) {
+        sub_0019531D_original();
+        return;
+    }
+    if (!reported) {
+        reported = 1;
+        fprintf(stderr, "[MM3_OFFLINE] network readiness forced to 1\n");
+    }
+    g_eax = 1;
+    g_esp += 4; /* original cdecl ret, no arguments */
+}
+
+/* Xbox Live's hand-over to the dashboard (0x296E94, stdcall, 4 arguments).
+ * Sign In with no account sets one up there: it launches d:\dashupdate.xbe
+ * (XLaunchNewImage, 0x296BED) and, failing that, reboots to the dashboard
+ * outright. With no dashboard either way quits the game, so report the
+ * hand-over as failed and stay in the game. */
+#define XONLINE_E_FAIL 0x80004005u
+void sub_00296E94(void)
+{
+    fprintf(stderr, "[MM3] Xbox Live dashboard hand-over refused: no dashboard\n");
+    fflush(stderr);
+    g_eax = XONLINE_E_FAIL;
+    g_esp += 20; /* ret 16 */
+}
