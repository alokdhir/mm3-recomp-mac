+#if !defined(_WIN32)
+/* arm64 Darwin: the same guest state as the Win32 report, with the host's
+ * PC/SP/LR from the signal frame and a native backtrace. */
+static LONG mm3_crash_report(EXCEPTION_POINTERS *info)
+{
+    const EXCEPTION_RECORD *record = info ? info->ExceptionRecord : NULL;
+    const CONTEXT *context = info ? info->ContextRecord : NULL;
+    ULONG_PTR fault = record && record->NumberParameters > 1
+        ? record->ExceptionInformation[1] : 0;
+    void *frames[32];
+    int count;
+
+    fprintf(stderr, "[CRASH] code=0x%08X fault=%p write=%d guest_esp=0x%08X eax=0x%08X\n",
+            record ? (unsigned)record->ExceptionCode : 0u, (void *)fault,
+            record ? (int)record->ExceptionInformation[0] : 0, g_esp, g_eax);
+    if (context && context->ss)
+        fprintf(stderr, "[CRASH] pc=%p sp=%p lr=%p esr=0x%08X\n",
+                (void *)arm_thread_state64_get_pc(*context->ss),
+                (void *)arm_thread_state64_get_sp(*context->ss),
+                (void *)arm_thread_state64_get_lr(*context->ss), context->esr);
+    fprintf(stderr, "[CRASH] xbox_mem_offset=%lld memory_base=%p guest_fault=0x%08llX\n",
+            (long long)g_xbox_mem_offset, xbox_GetMemoryBase(),
+            (unsigned long long)(fault - (uintptr_t)g_xbox_mem_offset));
+    fprintf(stderr, "[CRASH] guest fs=0x%08X ebp=0x%08X seh_ebp=0x%08X ecx=0x%08X ebx=0x%08X esi=0x%08X edi=0x%08X\n",
+            g_fs_base, g_ebp, g_seh_ebp, g_ecx, g_ebx, g_esi, g_edi);
+    if (g_ebp >= 0x10000u && g_ebp < MM3_MEMORY_MAP_SIZE - 8u)
+        fprintf(stderr, "[CRASH_CALLER] frame=%08X parent=%08X return=%08X\n",
+                g_ebp, MEM32(g_ebp), MEM32(g_ebp + 4u));
+    count = backtrace(frames, 32);
+    fflush(stderr);
+    backtrace_symbols_fd(frames, count, 2);
+    return EXCEPTION_CONTINUE_SEARCH;
+}
+#else
 static LONG WINAPI mm3_crash_report(EXCEPTION_POINTERS *info)
 {
     const EXCEPTION_RECORD *record = info ? info->ExceptionRecord : NULL;
@@ -132,6 +179,7 @@ static LONG WINAPI mm3_crash_report(EXCEPTION_POINTERS *info)
     fflush(stderr);
     return EXCEPTION_CONTINUE_SEARCH;
 }
+#endif
 
