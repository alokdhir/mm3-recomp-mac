diff --git a/src/mm3_recomp_types.h b/src/mm3_recomp_types.h
index 6cfdcf2..38f3dbc 100644
--- a/src/mm3_recomp_types.h
+++ b/src/mm3_recomp_types.h
@@ -402,6 +402,36 @@ void recomp_trace_esp(const char *name, const char *tag);
 #define SMEM32(addr) (*(volatile int32_t  *)XBOX_PTR(addr))
 #define SMEM64(addr) (*(volatile int64_t  *)XBOX_PTR(addr))
 
+/* xchg with memory is implicitly locked on x86: an atomic swap and a full
+ * barrier, and how InterlockedExchange compiles. A weakly ordered host needs
+ * it to be both (generate_mm3.py routes 32-bit memory xchg here). Exclusive
+ * access needs an aligned word, so an unaligned one keeps the plain swap. */
+static inline uint32_t recomp_xchg32(uint32_t addr, uint32_t value)
+{
+    volatile uint32_t *p = (volatile uint32_t *)XBOX_PTR(addr);
+    if (!(addr & 3u))
+        return __atomic_exchange_n((uint32_t *)p, value, __ATOMIC_SEQ_CST);
+    {
+        uint32_t old = *p;
+        *p = value;
+        return old;
+    }
+}
+
+/* CVTSS2SI/CVTSD2SI (round by MXCSR: nearest-even, which no title here
+ * changes) and their truncating CVTT forms, as x86 computes them: a value
+ * out of int32 range, or NaN, is the integer indefinite 0x80000000. A C cast
+ * is undefined there and saturates on arm64 (NaN becomes 0), and as the
+ * lifter wrote it the rounding forms truncated (generate_mm3.py routes the
+ * conversions here). */
+static inline uint32_t recomp_sse_cvt_i32(double value, int truncate)
+{
+    double r = truncate ? trunc(value) : nearbyint(value);
+    if (!(r >= -2147483648.0 && r <= 2147483647.0))
+        return 0x80000000u;
+    return (uint32_t)(int32_t)r;
+}
+
 /* Translated rep movs calls memcpy. The CRT memcpy may use AVX-512 moves,
  * which the MMIO trap handlers (APU, NV2A, ...) cannot decode: copying GP DSP
  * memory at 0xFE8312E4 crashed with "MMIO decode fail ... 62 F1 7F 4A 6F".
