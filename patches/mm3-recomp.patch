diff --git a/scripts/tso_accessors.py b/scripts/tso_accessors.py
new file mode 100644
index 0000000..5ee8a05
--- /dev/null
+++ b/scripts/tso_accessors.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""Route the generated code's guest memory accesses through ordered accessors.
+
+    python scripts/tso_accessors.py <in.c> <out.c>     (one file; the build runs it
+                                                        on every generated source,
+                                                        after the seams)
+    python scripts/tso_accessors.py <gen dir>          (every recomp_*.c, in place)
+
+x86 keeps every load and store in program order as other cores see them
+(TSO: only a store followed by a load may pass). arm64 does not, so guest
+threads that hand data over through plain memory -- a flag written after the
+data it guards, a ring index after its slot -- can see each other's writes out
+of order once they run on separate host cores. The lifter emits each access as
+MEMn(addr), a store as `MEMn(addr) = value;`. This rewrites stores to
+STn(addr, value) and every other access to LDn(addr) (SLDn for the signed
+SMEMn forms); mm3_recomp_types.h makes those load-acquire / store-release on
+arm64 hosts, which is TSO, and the plain accesses elsewhere. Accesses to the
+thread's own stack frame -- esp-based, or ebp with a negative offset (a local;
+with frame-pointer omission ebp is often an ordinary pointer, so nothing else
+ebp-based is assumed private) -- stay plain MEMn: no other thread reads a
+frame while it is live. Idempotent: running it again changes nothing.
+"""
+import re
+import sys
+from pathlib import Path
+
+NAMES = {'MEM8': ('LD8', 'ST8'), 'MEM16': ('LD16', 'ST16'), 'MEM32': ('LD32', 'ST32'),
+         'MEMF': ('LDF', 'STF'), 'MEMD': ('LDD', 'STD'),
+         'SMEM8': ('SLD8', 'ST8'), 'SMEM16': ('SLD16', 'ST16'), 'SMEM32': ('SLD32', 'ST32'),
+         'SMEM64': ('SLD64', 'ST64')}     # a signed store writes the same bits
+TOKEN = re.compile(r'\b(SMEM8|SMEM16|SMEM32|SMEM64|MEM8|MEM16|MEM32|MEMF|MEMD)\(')
+FRAME = re.compile(r'\s*\(?\s*(esp\b|ebp \+ -(0x[0-9A-Fa-f]+|\d+)\s*\)?\s*$)')
+
+
+def close_paren(s, i):
+    """Index of the ')' matching the '(' at s[i - 1]."""
+    depth = 1
+    while i < len(s):
+        c = s[i]
+        if c == '(':
+            depth += 1
+        elif c == ')':
+            depth -= 1
+            if depth == 0:
+                return i
+        elif c in '"\'':
+            q = c
+            i += 1
+            while i < len(s) and s[i] != q:
+                i += 2 if s[i] == '\\' else 1
+        elif s.startswith('/*', i):
+            i = s.index('*/', i + 2) + 1
+        i += 1
+    raise ValueError('unbalanced parentheses')
+
+
+def statement_end(s, i):
+    """Index of the ';' ending the expression that starts at s[i]."""
+    depth = 0
+    while i < len(s):
+        c = s[i]
+        if c in '([':
+            depth += 1
+        elif c in ')]':
+            if depth == 0:
+                return i                     # e.g. the end of a for(...) clause
+            depth -= 1
+        elif c == ';' and depth == 0:
+            return i
+        elif c in '"\'':
+            q = c
+            i += 1
+            while i < len(s) and s[i] != q:
+                i += 2 if s[i] == '\\' else 1
+        elif s.startswith('/*', i):
+            i = s.index('*/', i + 2) + 1
+        i += 1
+    raise ValueError('statement without an end')
+
+
+def rewrite(s, counts):
+    out, pos = [], 0
+    while True:
+        m = TOKEN.search(s, pos)
+        if not m:
+            out.append(s[pos:])
+            return ''.join(out)
+        out.append(s[pos:m.start()])
+        name = m.group(1)
+        end = close_paren(s, m.end())
+        addr = rewrite(s[m.end():end], counts)
+        j = end + 1
+        while j < len(s) and s[j] in ' \t':
+            j += 1
+        load, store = NAMES[name]
+        if FRAME.match(addr):
+            out.append(f'{name}({addr})')       # stack frame: thread-private
+            counts['frame'] += 1
+            pos = end + 1
+            continue
+        if store and j < len(s) and s[j] == '=' and s[j + 1:j + 2] != '=':
+            k = statement_end(s, j + 1)
+            value = rewrite(s[j + 1:k], counts).strip()
+            out.append(f'{store}({addr}, {value})')
+            counts['store'] += 1
+            pos = k                          # keeps the ';'
+        else:
+            out.append(f'{load}({addr})')
+            counts['load'] += 1
+            pos = end + 1
+
+
+def main(gen):
+    counts = {'load': 0, 'store': 0, 'frame': 0}
+    files = sorted(Path(gen).glob('recomp_*.c'))
+    for path in files:
+        text = path.read_text()
+        new = rewrite(text, counts)
+        if new != text:
+            path.write_text(new)
+    print(f'ordered accessors: {counts["load"]} loads, {counts["store"]} stores '
+          f'({counts["frame"]} stack-frame accesses left plain) in {len(files)} files')
+
+
+def one(src, dst):
+    counts = {'load': 0, 'store': 0, 'frame': 0}
+    text = Path(src).read_text()
+    new = rewrite(text, counts)
+    out = Path(dst)
+    if not out.exists() or out.read_text() != new:   # keep the timestamp when unchanged
+        out.parent.mkdir(parents=True, exist_ok=True)
+        out.write_text(new)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) == 3:
+        one(sys.argv[1], sys.argv[2])
+    elif len(sys.argv) == 2:
+        main(sys.argv[1])
+    else:
+        sys.exit(__doc__)
